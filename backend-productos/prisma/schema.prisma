generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id_producto          Int     @id @default(autoincrement())
  nombre_producto      String
  categoria_producto   String
  pvp_producto         Decimal @db.Decimal(10, 2)

  @@map("producto")
}
